{
  "name": "pulsechat",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pulsechat",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/dashboard": {
      "name": "@pulsechat/dashboard",
      "version": "0.0.1"
    },
    "node_modules/@pulsechat/dashboard": {
      "resolved": "apps/dashboard",
      "link": true
    },
    "node_modules/@pulsechat/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@pulsechat/shared",
      "version": "0.0.1"
    }
  }
}
